#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shared_binutils_path="${SHARED_BINUTILS_PATH:-$repo_root/../../malleatus/shared_binutils}"
local_dotfiles_path="${LOCAL_DOTFILES_PATH:-$repo_root/local-packages}"

platform() {
  case "$(uname -s)" in
    Darwin*) printf 'darwin' ;;
    Linux*) printf 'linux' ;;
    *) printf 'unknown' ;;
  esac
}

link_dotfile() {
  local src="$repo_root/$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"

  if [[ "${FORCE:-false}" == "true" ]]; then
    rm -rf "$dest"
  fi

  if [[ -L "$dest" ]]; then
    local current
    current="$(readlink "$dest")"
    if [[ ! -e "$current" ]]; then
      echo "$dest is a broken symlink, replacing it"
      rm "$dest"
      ln -s "$src" "$dest"
    elif [[ "$current" != "$src" ]]; then
      echo "$dest already exists and is symlinked to $current"
    fi
  elif [[ -e "$dest" ]]; then
    echo "$dest already exists and is not a symlink"
  else
    echo "creating link for $dest"
    ln -s "$src" "$dest"
  fi
}

dotfile_entries() {
  cat <<EOF
packages/nvim|$HOME/.config/nvim
packages/starship/pure.toml|$HOME/.config/starship.toml
packages/starship/|$HOME/.config/starship
packages/fish/|$HOME/.config/fish
packages/atuin|$HOME/.config/atuin
packages/git/gitconfig|$HOME/.gitconfig
packages/git/gitignore_global|$HOME/.gitignore_global
packages/gh/config.yml|$HOME/.config/gh/config.yml
packages/tmux/tmux.conf|$HOME/.tmux.conf
packages/cargo/config.toml|$HOME/.cargo/config.toml
packages/binutils/config/|$HOME/.config/binutils
packages/wezterm/|$HOME/.config/wezterm
packages/ghostty/|$HOME/.config/ghostty
packages/ssh/rc|$HOME/.ssh/rc
packages/mise/|$HOME/.config/mise
packages/mcp/|$HOME/.config/mcp
packages/ai/|$HOME/.config/ai
packages/hammerspoon/|$HOME/.hammerspoon
EOF

  if [[ "$(platform)" == "darwin" ]]; then
    cat <<EOF
packages/vscode/settings.json|$HOME/Library/Application Support/Code/User/settings.json
packages/vscode/keybindings.json|$HOME/Library/Application Support/Code/User/keybindings.json
packages/vscode/snippets|$HOME/Library/Application Support/Code/User/snippets
packages/tealdeer/config.toml|$HOME/Library/Application Support/tealdeer/config.toml
packages/jj/|$HOME/Library/Application Support/jj
packages/alfred/snippets|$HOME/Library/Application Support/Alfred/Alfred.alfredpreferences/snippets
packages/iterm2/|$HOME/.config/iterm2
EOF
  fi

  if [[ "$(platform)" == "linux" ]]; then
    echo "packages/jj/|$HOME/.config/jj"
  fi
}

remove_link_if_managed() {
  local src="$repo_root/$1"
  local dest="$2"
  local mode="${3:-dry-run}"

  if [[ ! -L "$dest" ]]; then
    if [[ -e "$dest" ]]; then
      echo "skip non-symlink: $dest"
    else
      echo "missing: $dest"
    fi
    return 0
  fi

  local current
  current="$(readlink "$dest")"
  local current_physical src_physical
  current_physical="$(cd "$current" 2>/dev/null && pwd -P || printf '%s' "$current")"
  src_physical="$(cd "$src" 2>/dev/null && pwd -P || printf '%s' "$src")"

  if [[ "$current_physical" != "$src_physical" ]]; then
    echo "skip unmanaged symlink: $dest -> $current"
    return 0
  fi

  if [[ "$mode" == "apply" ]]; then
    rm "$dest"
    echo "removed: $dest"
  else
    echo "would remove: $dest"
  fi
}

copy_dotfile() {
  local src="$repo_root/$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"

  if [[ -e "$dest" ]]; then
    echo "$dest already exists"
  else
    echo "creating $dest"
    cp "$src" "$dest"
  fi
}

ensure_dirs() {
  mkdir -p "$HOME/bin" "$HOME/.ssh" "$HOME/.cargo"
}

link_common_dotfiles() {
  local entries=(
    "packages/nvim|$HOME/.config/nvim"
    "packages/starship/pure.toml|$HOME/.config/starship.toml"
    "packages/starship/|$HOME/.config/starship"
    "packages/fish/|$HOME/.config/fish"
    "packages/atuin|$HOME/.config/atuin"
    "packages/git/gitconfig|$HOME/.gitconfig"
    "packages/git/gitignore_global|$HOME/.gitignore_global"
    "packages/gh/config.yml|$HOME/.config/gh/config.yml"
    "packages/tmux/tmux.conf|$HOME/.tmux.conf"
    "packages/cargo/config.toml|$HOME/.cargo/config.toml"
    "packages/binutils/config/|$HOME/.config/binutils"
    "packages/wezterm/|$HOME/.config/wezterm"
    "packages/ghostty/|$HOME/.config/ghostty"
    "packages/ssh/rc|$HOME/.ssh/rc"
    "packages/mise/|$HOME/.config/mise"
    "packages/mcp/|$HOME/.config/mcp"
    "packages/ai/|$HOME/.config/ai"
    "packages/hammerspoon/|$HOME/.hammerspoon"
  )

  for entry in "${entries[@]}"; do
    link_dotfile "${entry%%|*}" "${entry#*|}"
  done
}

link_macos_dotfiles() {
  if [[ "$(platform)" != "darwin" ]]; then
    return 0
  fi

  local entries=(
    "packages/vscode/settings.json|$HOME/Library/Application Support/Code/User/settings.json"
    "packages/vscode/keybindings.json|$HOME/Library/Application Support/Code/User/keybindings.json"
    "packages/vscode/snippets|$HOME/Library/Application Support/Code/User/snippets"
    "packages/tealdeer/config.toml|$HOME/Library/Application Support/tealdeer/config.toml"
    "packages/jj/|$HOME/Library/Application Support/jj"
    "packages/alfred/snippets|$HOME/Library/Application Support/Alfred/Alfred.alfredpreferences/snippets"
    "packages/iterm2/|$HOME/.config/iterm2"
  )

  for entry in "${entries[@]}"; do
    link_dotfile "${entry%%|*}" "${entry#*|}"
  done

  if command -v defaults >/dev/null 2>&1; then
    defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$HOME/.config/iterm2"
    defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
    echo "iTerm2 configured to load preferences from ~/.config/iterm2"
  fi
}

link_linux_dotfiles() {
  if [[ "$(platform)" != "linux" ]]; then
    return 0
  fi

  link_dotfile "packages/jj/" "$HOME/.config/jj"
}

copy_local_templates() {
  copy_dotfile "packages/git/gitconfig.local" "$HOME/.gitconfig.local"
  copy_dotfile "packages/tmux/tmux.local.conf" "$HOME/.tmux.local.conf"
}

setup_local_dotfiles() {
  "$repo_root/scripts/binutils" build
  "$shared_binutils_path/target/debug/setup-local-dotfiles" \
    --local-dotfiles-path "$local_dotfiles_path"
}

refresh_shell() {
  "$repo_root/scripts/binutils" cache-shell-startup
  rm -f "$HOME/.cache/prezto/zcompdump"
  zsh -c 'autoload -Uz compinit && compinit'
}

install() {
  ensure_dirs
  link_common_dotfiles
  link_macos_dotfiles
  link_linux_dotfiles
  copy_local_templates
  setup_local_dotfiles
  refresh_shell
}

reset() {
  local mode="dry-run"
  if [[ "${1:-}" == "--apply" ]]; then
    mode="apply"
  fi

  echo "Dotfiles reset ($mode)"
  echo
  echo "Only symlinks that point back to this checkout are removed."
  echo "Copied local templates, app state, auth, caches, and secrets are left untouched."
  echo

  dotfile_entries | while IFS='|' read -r src dest; do
    remove_link_if_managed "$src" "$dest" "$mode"
  done

  if [[ "$mode" == "dry-run" ]]; then
    echo
    echo "Dry run only. Re-run with --apply to remove managed symlinks."
  fi
}

case "${1:-}" in
  install)
    install
    ;;
  reset)
    reset "${2:-}"
    ;;
  refresh-shell)
    refresh_shell
    ;;
  *)
    echo "usage: scripts/dotfiles <install|reset|refresh-shell> [--apply]" >&2
    exit 2
    ;;
esac
