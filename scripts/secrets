#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="$repo_root/packages/secrets"

usage() {
  echo "usage: scripts/secrets <export|import|list> [args]" >&2
}

list_secrets() {
  echo "=== SSH Keys ==="
  ls -la ~/.ssh/id_* ~/.ssh/config ~/.ssh/known_hosts 2>/dev/null || echo "  (none found)"
  echo
  echo "=== GPG Keys ==="
  gpg --list-secret-keys --keyid-format LONG 2>/dev/null || echo "  (none found)"
  echo
  echo "=== Local Config Files ==="
  for file in ~/.gitconfig.local ~/.zshrc.local ~/.npmrc ~/.config/fish/local.fish ~/.config/gh/hosts.yml; do
    if [[ -f "$file" ]]; then
      echo "  $file"
    fi
  done
  echo
  echo "=== Environment Files ==="
  for file in ~/.env ~/.envrc; do
    if [[ -f "$file" ]]; then
      echo "  $file"
    fi
  done
}

case "${1:-}" in
  export)
    shift
    "$secrets_dir/export.sh" "$@"
    ;;
  import)
    shift
    if [[ $# -eq 0 ]]; then
      echo "Usage: scripts/secrets import <secrets-file.tar.gpg>" >&2
      exit 2
    fi
    "$secrets_dir/import.sh" "$@"
    ;;
  list)
    list_secrets
    ;;
  *)
    usage
    exit 2
    ;;
esac
