#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ai_dir="$repo_root/packages/ai"

usage() {
  echo "usage: scripts/ai-stack <validate|doctor|completion-audit|bootstrap-verify|bootstrap-verify-preflight|bootstrap-verification-plan|inventory|live-inventory|review|report|snapshot-skills|skill-drift|feedback|usage|usage-report|prompt-plan|archive-plan|generate-commands|diff-commands|install-commands|reset-commands|reset|generate-mcp|diff-mcp|sync-mcp> [--apply|--strict]"
}

validate() {
  test -f "$ai_dir/registry.yaml"
  test -f "$ai_dir/mcp/servers.json"

  if ! grep -q '^version: [0-9][0-9]*$' "$ai_dir/registry.yaml"; then
    echo "registry missing numeric version" >&2
    exit 1
  fi
  if ! grep -q '^owner: ' "$ai_dir/registry.yaml"; then
    echo "registry missing owner" >&2
    exit 1
  fi
  if ! grep -Eq '^last_audited: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$ai_dir/registry.yaml"; then
    echo "registry missing last_audited date" >&2
    exit 1
  fi
  for section in decisions tooling clients mcp_servers skills prompts knowledge lifecycle; do
    if ! grep -q "^$section:" "$ai_dir/registry.yaml"; then
      echo "registry missing section: $section" >&2
      exit 1
    fi
  done
  for bucket in keep consolidate replace archive delete; do
    if ! grep -q "^  $bucket:" "$ai_dir/registry.yaml"; then
      echo "registry lifecycle missing bucket: $bucket" >&2
      exit 1
    fi
  done

  if command -v jq >/dev/null 2>&1; then
    jq empty "$ai_dir/mcp/servers.json"
    jq -e '
      (.mcpServers | type == "object") and
      (.mcpServers | length > 0) and
      (all(.mcpServers | keys[]; test("^[a-z0-9][a-z0-9-]*$"))) and
      (all(.mcpServers[]; (
        (.command | type == "string" and length > 0) and
        (.args | type == "array") and
        (all(.args[]; type == "string")) and
        (has("url") | not) and
        (has("headers") | not) and
        (has("env") | not)
      )))
    ' "$ai_dir/mcp/servers.json" >/dev/null || {
      echo "invalid public MCP catalog shape: $ai_dir/mcp/servers.json" >&2
      exit 1
    }
    find "$ai_dir/commands" -type f -name '*.json' -print | while read -r spec; do
      jq empty "$spec"
      jq -e '
        (.version | type == "number") and
        (.commands | type == "array") and
        (.commands | length > 0) and
        (all(.commands[]; (
          (.id | type == "string" and test("^[a-z0-9][a-z0-9-]*$")) and
          (.description | type == "string" and length > 0) and
          (.title | type == "string" and length > 0) and
          (.shell | type == "string" and length > 0) and
          (.task | type == "string" and length > 0) and
          (.opencodeMessage | type == "string" and length > 0)
        ))) and
        (([.commands[].id] | length) == ([.commands[].id] | unique | length))
      ' "$spec" >/dev/null || {
        echo "invalid command spec shape: $spec" >&2
        exit 1
      }
    done
    find "$ai_dir/generated/mcp" -type f \( -name '*.json' -o -name '*.jsonc' \) -print 2>/dev/null | while read -r generated_mcp; do
      jq empty "$generated_mcp"
    done
  fi

  if [[ -f "$ai_dir/generated/mcp/shared/servers.json" ]] && ! cmp -s "$ai_dir/generated/mcp/shared/servers.json" "$repo_root/packages/mcp/servers.json"; then
    echo "packages/mcp/servers.json is out of sync; run scripts/ai-stack sync-mcp" >&2
    exit 1
  fi

  find "$ai_dir/prompts" -type f -name '*.md' ! -name 'README.md' -print | while read -r prompt; do
    local first_line prompt_id
    first_line="$(head -n 1 "$prompt")"
    prompt_id="$(basename "$prompt" .md)"
    if [[ "$first_line" != "---" ]]; then
      echo "missing frontmatter: $prompt" >&2
      exit 1
    fi
    if [[ "$(awk '/^---$/ { count++ } END { print count + 0 }' "$prompt")" -lt 2 ]]; then
      echo "unterminated frontmatter: $prompt" >&2
      exit 1
    fi
    if ! grep -q "^id: $prompt_id$" "$prompt"; then
      echo "prompt id must match filename: $prompt" >&2
      exit 1
    fi
    if ! grep -Eq '^status: (keep|consolidate|archive)$' "$prompt"; then
      echo "prompt missing valid status: $prompt" >&2
      exit 1
    fi
    if ! grep -q '^source: ' "$prompt"; then
      echo "prompt missing source: $prompt" >&2
      exit 1
    fi
    if ! grep -q '^clients:$' "$prompt"; then
      echo "prompt missing clients list: $prompt" >&2
      exit 1
    fi
  done

  find "$ai_dir/skills" -mindepth 2 -maxdepth 2 -name manifest.yaml -print | while read -r manifest; do
    skill_dir="$(dirname "$manifest")"
    if ! grep -q '^id:' "$manifest"; then
      echo "missing id in $manifest" >&2
      exit 1
    fi
    if ! grep -q '^status:' "$manifest"; then
      echo "missing status in $manifest" >&2
      exit 1
    fi
    if grep -q '^  path: packages/ai/skills/' "$manifest" && [[ ! -f "$skill_dir/SKILL.md" ]]; then
      echo "missing SKILL.md for repo-owned skill: $skill_dir" >&2
      exit 1
    fi
  done

  find "$ai_dir/agents" -mindepth 2 -maxdepth 2 -name manifest.yaml -print | while read -r manifest; do
    if ! grep -q '^id:' "$manifest"; then
      echo "missing id in $manifest" >&2
      exit 1
    fi
    if ! grep -Eq '^status: (keep|consolidate|proposed|replace|archive)$' "$manifest"; then
      echo "missing valid status in $manifest" >&2
      exit 1
    fi
    for field in owner last_reviewed description agents decision; do
      if ! grep -q "^$field:" "$manifest"; then
        echo "missing $field in $manifest" >&2
        exit 1
      fi
    done
    if ! grep -q '^    purpose: ' "$manifest"; then
      echo "agent manifest needs at least one purpose: $manifest" >&2
      exit 1
    fi
  done

  if [[ -f "$ai_dir/skills/managed-lock.snapshot.tsv" ]]; then
    awk -F '\t' 'NF != 7 { print "invalid snapshot row " NR ": expected 7 tab-separated fields" > "/dev/stderr"; exit 1 }' "$ai_dir/skills/managed-lock.snapshot.tsv"
  fi
}

doctor_check_path() {
  local path="$1"
  local description="$2"

  if [[ -e "$path" ]]; then
    printf 'ok   %s\n' "$description"
  else
    printf 'fail %s (%s)\n' "$description" "$path"
    return 1
  fi
}

doctor_check_grep() {
  local pattern="$1"
  local path="$2"
  local description="$3"

  if grep -q "$pattern" "$path"; then
    printf 'ok   %s\n' "$description"
  else
    printf 'fail %s (%s)\n' "$description" "$path"
    return 1
  fi
}

doctor() {
  local failures=0

  echo "AI stack doctor"
  echo

  if validate; then
    printf 'ok   base validation\n'
  else
    printf 'fail base validation\n'
    failures=$((failures + 1))
  fi

  doctor_check_path "$ai_dir/registry.yaml" "registry exists" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/commands/plannotator.json" "canonical Plannotator command spec exists" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/commands/claude/plannotator-review.md" "Claude command shim generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/commands/codex/plannotator-review.md" "Codex command shim generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/commands/cursor/plannotator-review.md" "Cursor command shim generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/commands/opencode/plannotator-review.md" "opencode command shim generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/mcp/shared/servers.json" "shared MCP profile generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/mcp/cursor/mcp.json" "Cursor MCP profile generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/generated/mcp/codex/config.toml" "Codex MCP snippet generated" || failures=$((failures + 1))
  doctor_check_path "$ai_dir/feedback/README.md" "feedback-loop docs exist" || failures=$((failures + 1))
  doctor_check_path "$repo_root/docs/ai-stack.md" "AI stack docs exist" || failures=$((failures + 1))
  doctor_check_path "$repo_root/docs/mise-task-migration.md" "mise migration docs exist" || failures=$((failures + 1))

  doctor_check_grep 'ai:completion:audit' "$repo_root/mise.toml" "mise completion audit task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:feedback' "$repo_root/mise.toml" "mise feedback task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:usage:report' "$repo_root/mise.toml" "mise usage report task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:prompt:plan' "$repo_root/mise.toml" "mise prompt plan task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:archive:plan' "$repo_root/mise.toml" "mise archive plan task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:bootstrap:verify' "$repo_root/mise.toml" "mise bootstrap verification task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:bootstrap:verify:preflight' "$repo_root/mise.toml" "mise bootstrap verification preflight task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:bootstrap:verification:plan' "$repo_root/mise.toml" "mise bootstrap verification plan task registered" || failures=$((failures + 1))
  doctor_check_grep 'ai:reset' "$repo_root/mise.toml" "mise AI reset task registered" || failures=$((failures + 1))
  doctor_check_grep 'reset:dry-run' "$repo_root/mise.toml" "mise dotfiles reset dry-run task registered" || failures=$((failures + 1))
  doctor_check_grep 'migration:go-task:retire-check' "$repo_root/mise.toml" "mise go-task retirement check registered" || failures=$((failures + 1))
  doctor_check_grep 'migration:go-task:archive-compat' "$repo_root/mise.toml" "mise go-task archive task registered" || failures=$((failures + 1))

  echo
  if [[ "$failures" -eq 0 ]]; then
    echo "AI stack doctor: ok"
  else
    echo "AI stack doctor: $failures failure(s)"
    return 1
  fi
}

audit_ok() {
  printf 'ok      %s\n' "$1"
  printf '        evidence: %s\n' "$2"
}

audit_missing() {
  printf 'missing %s\n' "$1"
  printf '        expected: %s\n' "$2"
}

audit_open() {
  printf 'open    %s\n' "$1"
  printf '        next: %s\n' "$2"
}

audit_path() {
  local path="$1"
  local description="$2"
  local evidence="$3"

  if [[ -e "$path" ]]; then
    audit_ok "$description" "$evidence"
  else
    audit_missing "$description" "$path"
    return 1
  fi
}

audit_grep() {
  local pattern="$1"
  local path="$2"
  local description="$3"
  local evidence="$4"

  if [[ -e "$path" ]] && grep -q "$pattern" "$path"; then
    audit_ok "$description" "$evidence"
  else
    audit_missing "$description" "$path contains $pattern"
    return 1
  fi
}

audit_mise_task() {
  local task="$1"
  local description="$2"

  if grep -q "\\[tasks\\.\"$task\"\\]" "$repo_root/mise.toml" || grep -q "\\[tasks\\.$task\\]" "$repo_root/mise.toml"; then
    audit_ok "$description" "mise.toml registers $task"
  else
    audit_missing "$description" "mise.toml registers $task"
    return 1
  fi
}

valid_bootstrap_verification_record() {
  local record="$1"
  local required_command

  grep -Eq '^date: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$record" || return 1
  grep -q '^result: pass$' "$record" || return 1
  grep -Eq '^platform: (darwin|linux)$' "$record" || return 1
  grep -Eq '^arch: (arm64|x86_64)$' "$record" || return 1
  grep -Eq '^dotfiles_commit: [0-9a-f]{7,40}$' "$record" || return 1
  grep -Eq '^environment: (fresh-machine|disposable-vm|clean-user)$' "$record" || return 1
  grep -Eq '^verified_by: [A-Za-z0-9_-]+$' "$record" || return 1

  if grep -Eq 'YYYY-MM-DD|SHORT_SHA|darwin\|linux|arm64\|x86_64|fresh-machine\|disposable-vm\|clean-user' "$record"; then
    return 1
  fi

  for required_command in \
    'curl -fsSL https://raw.githubusercontent.com/scalvert/dotfiles/main/install | bash' \
    'mise run ai:validate' \
    'mise run ai:doctor' \
    'mise run ai:completion:audit' \
    'mise run migration:go-task:retire-check' \
    'mise run ai:reset:dry-run' \
    'mise run reset:dry-run'; do
    grep -Fq "$required_command" "$record" || return 1
  done
}

bootstrap_verification_record() {
  local verification_dir="$ai_dir/bootstrap-verifications"

  if [[ ! -d "$verification_dir" ]]; then
    return 1
  fi

  while read -r record; do
    if valid_bootstrap_verification_record "$record"; then
      printf '%s\n' "$record"
      return 0
    fi
  done < <(find "$verification_dir" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' ! -name 'TEMPLATE.md' -print | sort)

  return 1
}

bootstrap_state_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
}

bootstrap_marker_path() {
  printf '%s/bootstrap.env\n' "$(bootstrap_state_dir)"
}

marker_value() {
  local marker="$1"
  local key="$2"

  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; found=1; exit } END { exit 0 }' "$marker"
}

current_platform() {
  case "$(uname -s)" in
    Darwin*) printf 'darwin' ;;
    Linux*) printf 'linux' ;;
    *) printf 'unknown' ;;
  esac
}

current_arch() {
  case "$(uname -m)" in
    arm64|aarch64) printf 'arm64' ;;
    x86_64|amd64) printf 'x86_64' ;;
    *) uname -m ;;
  esac
}

parse_bootstrap_verification_options() {
  environment="${AI_BOOTSTRAP_VERIFY_ENVIRONMENT:-}"
  verified_by="${AI_BOOTSTRAP_VERIFY_VERIFIED_BY:-steve}"
  output="${AI_BOOTSTRAP_VERIFY_OUTPUT:-}"
  failure_output="${AI_BOOTSTRAP_VERIFY_FAILURE_OUTPUT:-}"

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --environment)
        if [[ "$#" -lt 2 ]]; then
          echo "--environment requires a value" >&2
          return 2
        fi
        environment="${2:-}"
        shift 2
        ;;
      --verified-by)
        if [[ "$#" -lt 2 ]]; then
          echo "--verified-by requires a value" >&2
          return 2
        fi
        verified_by="${2:-}"
        shift 2
        ;;
      --output)
        if [[ "$#" -lt 2 ]]; then
          echo "--output requires a value" >&2
          return 2
        fi
        output="${2:-}"
        shift 2
        ;;
      --failure-output)
        if [[ "$#" -lt 2 ]]; then
          echo "--failure-output requires a value" >&2
          return 2
        fi
        failure_output="${2:-}"
        shift 2
        ;;
      *)
        echo "unknown bootstrap verification option: $1" >&2
        return 2
        ;;
    esac
  done

  if [[ ! "$environment" =~ ^(fresh-machine|disposable-vm|clean-user)$ ]]; then
    echo "bootstrap verification requires --environment fresh-machine|disposable-vm|clean-user" >&2
    return 2
  fi
  if [[ ! "$verified_by" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "bootstrap verification verified_by must match [A-Za-z0-9_-]+" >&2
    return 2
  fi
}

bootstrap_verify_preflight() {
  local environment verified_by output failure_output
  local failures=0
  local home_path="${HOME:-}"
  local config_paths

  parse_bootstrap_verification_options "$@" || return $?

  echo "Bootstrap verification preflight"
  echo
  echo "environment: $environment"
  echo "platform: $(current_platform)"
  echo "arch: $(current_arch)"
  echo "home: ${home_path:-unset}"
  echo

  if [[ "$environment" == "clean-user" ]]; then
    case "$home_path" in
      /tmp/*|/private/tmp/*|/var/folders/*|/private/var/folders/*)
        echo "fail clean-user verification cannot use a temporary HOME: $home_path"
        failures=$((failures + 1))
        ;;
      "")
        echo "fail HOME is not set"
        failures=$((failures + 1))
        ;;
      *)
        echo "ok   HOME is not a temporary directory"
        ;;
    esac
  fi

  if [[ -n "$home_path" && ( -f "$home_path/.mise/config.toml" || -f "$home_path/.config/mise/config.toml" ) ]]; then
    echo "warn user-level mise config exists; ensure this is intentional for the verification account"
  else
    echo "ok   no user-level mise config detected"
  fi

  if command -v mise >/dev/null 2>&1; then
    config_paths="$(cd "$repo_root" && mise config ls --no-header 2>/dev/null | awk '{print $1}' || true)"
    if grep -Fxq "$repo_root/mise.toml" <<<"$config_paths"; then
      echo "ok   repo mise config is visible"
    else
      echo "fail repo mise config is not visible to mise"
      failures=$((failures + 1))
    fi
    if grep -Ev "^$repo_root/mise.toml$|^$home_path/|^$repo_root/" <<<"$config_paths" | grep -q .; then
      echo "fail mise is loading config outside this verification environment:"
      grep -Ev "^$repo_root/mise.toml$|^$home_path/|^$repo_root/" <<<"$config_paths"
      failures=$((failures + 1))
    else
      echo "ok   no external mise config paths detected"
    fi
  else
    echo "fail mise is not installed"
    failures=$((failures + 1))
  fi

  if [[ "$failures" -gt 0 ]]; then
    echo
    echo "Bootstrap verification preflight failed: $failures issue(s)"
    return 1
  fi

  echo
  echo "Bootstrap verification preflight: ok"
}

bootstrap_verification_plan() {
  local environment verified_by output failure_output
  local current_commit date worktree_state

  parse_bootstrap_verification_options --environment "${AI_BOOTSTRAP_VERIFY_ENVIRONMENT:-fresh-machine}" "$@" || return $?

  current_commit="$(git -C "$repo_root" rev-parse --short=12 HEAD)"
  date="$(date -u +%Y-%m-%d)"
  if [[ -z "$(git -C "$repo_root" status --porcelain)" ]]; then
    worktree_state="clean"
  else
    worktree_state="dirty - commit and push before using this plan"
  fi

  cat <<EOF
# Bootstrap Verification Plan

Date: $date
Commit: $current_commit
Worktree: $worktree_state
Environment: $environment
Verified by: $verified_by

Use this on a real fresh machine, disposable VM, or separate OS user account.
Do not use a temporary HOME inside the current login session as clean-user proof.

## 1. Bootstrap

\`\`\`bash
curl -fsSL https://raw.githubusercontent.com/scalvert/dotfiles/main/install | bash
cd ~/workspace/personal/dotfiles
\`\`\`

## 2. Preflight

\`\`\`bash
AI_BOOTSTRAP_VERIFY_ENVIRONMENT=$environment AI_BOOTSTRAP_VERIFY_VERIFIED_BY=$verified_by mise run ai:bootstrap:verify:preflight
\`\`\`

## 3. Record Pass Or Failure

\`\`\`bash
AI_BOOTSTRAP_VERIFY_ENVIRONMENT=$environment AI_BOOTSTRAP_VERIFY_VERIFIED_BY=$verified_by mise run ai:bootstrap:verify
\`\`\`

The pass record should be committed from \`packages/ai/bootstrap-verifications/\`.
Failure records, if generated, should be reviewed for sanitization before commit.

## 4. Retire go-task Compatibility After Pass Record

\`\`\`bash
mise run migration:go-task:archive-compat:dry-run
mise run migration:go-task:archive-compat
mise run ai:completion:audit:strict
\`\`\`
EOF
}

bootstrap_failure_record_path() {
  local environment="$1"
  local stage="$2"

  printf '%s/bootstrap-verifications/failures/%s-%s-%s.md\n' \
    "$ai_dir" \
    "$(date -u +%Y%m%dT%H%M%SZ)" \
    "$environment" \
    "$stage"
}

write_bootstrap_failure_record() {
  local environment="$1"
  local verified_by="$2"
  local stage="$3"
  local failed_command="$4"
  local notes="$5"
  local target="$6"
  local date platform arch current_commit

  date="$(date -u +%Y-%m-%d)"
  platform="$(current_platform)"
  arch="$(current_arch)"
  current_commit="$(git -C "$repo_root" rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown')"

  if [[ -z "$target" ]]; then
    target="$(bootstrap_failure_record_path "$environment" "$stage")"
  fi

  if [[ -e "$target" ]]; then
    echo "bootstrap failure record already exists: $target" >&2
    return 1
  fi

  mkdir -p "$(dirname "$target")"
  cat > "$target" <<EOF
---
date: $date
result: fail
platform: $platform
arch: $arch
dotfiles_commit: $current_commit
environment: $environment
verified_by: $verified_by
failed_stage: $stage
failed_command: $failed_command
---

# Bootstrap Verification Failure - $date

## Scope

- mise-first bootstrap from \`install\`
- bootstrap verification gates
- non-destructive reset dry runs
- go-task retirement gate

## Result

Pass/fail: fail

Failed stage: $stage

Failed command: $failed_command

## Sanitized Notes

- $notes
- Raw logs, hostnames, usernames, absolute home paths, secrets, and private URLs were not recorded.
EOF

  echo "bootstrap failure record written: ${target#$repo_root/}" >&2
}

run_bootstrap_gate() {
  local command="$1"

  printf '\nRunning: %s\n' "$command"
  case "$command" in
    'mise run ai:validate')
      (cd "$repo_root" && mise run ai:validate)
      ;;
    'mise run ai:doctor')
      (cd "$repo_root" && mise run ai:doctor)
      ;;
    'mise run ai:completion:audit')
      (cd "$repo_root" && mise run ai:completion:audit)
      ;;
    'mise run migration:go-task:retire-check')
      (cd "$repo_root" && mise run migration:go-task:retire-check)
      ;;
    'mise run ai:reset:dry-run')
      (cd "$repo_root" && mise run ai:reset:dry-run)
      ;;
    'mise run reset:dry-run')
      (cd "$repo_root" && mise run reset:dry-run)
      ;;
    *)
      echo "unknown bootstrap verification gate: $command" >&2
      return 2
      ;;
  esac
}

bootstrap_verify() {
  local environment verified_by output failure_output
  local marker marker_commit current_commit marker_source date platform arch
  local failed_command command
  local commands=(
    'mise run ai:validate'
    'mise run ai:doctor'
    'mise run ai:completion:audit'
    'mise run migration:go-task:retire-check'
    'mise run ai:reset:dry-run'
    'mise run reset:dry-run'
  )

  parse_bootstrap_verification_options "$@" || return $?
  if ! bootstrap_verify_preflight --environment "$environment" --verified-by "$verified_by"; then
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "preflight" \
      "mise run ai:bootstrap:verify:preflight" \
      "Preflight rejected the verification environment. Re-run the preflight directly for actionable details." \
      "$failure_output" || true
    return 1
  fi

  marker="$(bootstrap_marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "bootstrap success marker is missing: $marker" >&2
    echo "run the top-level install command on the verification machine first" >&2
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "bootstrap-marker" \
      "install" \
      "Bootstrap success marker was missing, so the installer did not complete in this verification environment." \
      "$failure_output" || true
    return 1
  fi

  marker_commit="$(marker_value "$marker" dotfiles_commit)"
  marker_source="$(marker_value "$marker" source)"
  current_commit="$(git -C "$repo_root" rev-parse --short=12 HEAD)"
  if [[ -z "$marker_commit" || -z "$marker_source" ]]; then
    echo "bootstrap marker is missing required fields: $marker" >&2
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "bootstrap-marker" \
      "install" \
      "Bootstrap marker exists but is missing required metadata." \
      "$failure_output" || true
    return 1
  fi
  if [[ "$marker_commit" != "$current_commit" ]]; then
    echo "bootstrap marker commit ($marker_commit) does not match current checkout ($current_commit)" >&2
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "bootstrap-marker" \
      "install" \
      "Bootstrap marker commit did not match the current checkout commit." \
      "$failure_output" || true
    return 1
  fi
  if [[ "$marker_source" != "mise-install" ]]; then
    echo "bootstrap marker source is not mise-install: $marker_source" >&2
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "bootstrap-marker" \
      "install" \
      "Bootstrap marker source was not mise-install." \
      "$failure_output" || true
    return 1
  fi

  failed_command=""
  for command in "${commands[@]}"; do
    if ! run_bootstrap_gate "$command"; then
      failed_command="$command"
      break
    fi
  done

  if [[ -n "$failed_command" ]]; then
    echo "bootstrap verification failed at: $failed_command" >&2
    write_bootstrap_failure_record \
      "$environment" \
      "$verified_by" \
      "verification-gate" \
      "$failed_command" \
      "A required post-bootstrap verification gate failed." \
      "$failure_output" || true
    return 1
  fi

  date="$(date -u +%Y-%m-%d)"
  platform="$(current_platform)"
  arch="$(current_arch)"
  if [[ -z "$output" ]]; then
    output="$ai_dir/bootstrap-verifications/$date-$environment.md"
  fi

  if [[ -e "$output" ]]; then
    echo "verification record already exists: $output" >&2
    return 1
  fi

  mkdir -p "$(dirname "$output")"
  cat > "$output" <<EOF
---
date: $date
result: pass
platform: $platform
arch: $arch
dotfiles_commit: $current_commit
environment: $environment
verified_by: $verified_by
---

# Fresh-Machine Bootstrap Verification - $date

## Scope

- mise-first bootstrap from \`install\`
- primary install task graph
- AI stack validation
- non-destructive reset dry runs
- go-task retirement gate

## Commands

\`\`\`bash
curl -fsSL https://raw.githubusercontent.com/scalvert/dotfiles/main/install | bash
mise run ai:validate
mise run ai:doctor
mise run ai:completion:audit
mise run migration:go-task:retire-check
mise run ai:reset:dry-run
mise run reset:dry-run
\`\`\`

## Result

Pass/fail: pass

## Sanitized Notes

- Generated by \`mise run ai:bootstrap:verify\` after a successful install marker.
- Raw logs, hostnames, usernames, secrets, and private URLs were not recorded.
EOF

  echo "bootstrap verification record written: ${output#$repo_root/}"
}

completion_audit() {
  local strict="${1:-}"
  local missing=0
  local open=0

  echo "AI stack completion audit"
  echo
  echo "This checks repository evidence for the consolidation goal. It does not inspect private auth, histories, caches, or proprietary document contents."
  echo

  audit_path "$ai_dir/registry.yaml" "Canonical inventory exists" "packages/ai/registry.yaml" || missing=$((missing + 1))
  audit_path "$ai_dir/REGISTRY.md" "Registry representation is documented" "packages/ai/REGISTRY.md" || missing=$((missing + 1))
  audit_grep '^tooling:' "$ai_dir/registry.yaml" "Tooling inventory is represented" "registry has tooling section" || missing=$((missing + 1))
  audit_grep '^clients:' "$ai_dir/registry.yaml" "AI clients are inventoried" "registry has clients section" || missing=$((missing + 1))
  audit_grep '^mcp_servers:' "$ai_dir/registry.yaml" "MCP servers are inventoried" "registry has mcp_servers section" || missing=$((missing + 1))
  audit_grep '^skills:' "$ai_dir/registry.yaml" "Skills are inventoried" "registry has skills section" || missing=$((missing + 1))
  audit_grep '^prompts:' "$ai_dir/registry.yaml" "Prompts are inventoried" "registry has prompts section" || missing=$((missing + 1))
  audit_grep '^knowledge:' "$ai_dir/registry.yaml" "Knowledge systems are inventoried" "registry has knowledge section" || missing=$((missing + 1))
  audit_grep '^  keep:' "$ai_dir/registry.yaml" "Keep decisions are recorded" "registry lifecycle.keep" || missing=$((missing + 1))
  audit_grep '^  consolidate:' "$ai_dir/registry.yaml" "Consolidate decisions are recorded" "registry lifecycle.consolidate" || missing=$((missing + 1))
  audit_grep '^  replace:' "$ai_dir/registry.yaml" "Replace decisions are recorded" "registry lifecycle.replace" || missing=$((missing + 1))
  audit_grep '^  archive:' "$ai_dir/registry.yaml" "Archive decisions are recorded" "registry lifecycle.archive" || missing=$((missing + 1))
  audit_grep '^  delete:' "$ai_dir/registry.yaml" "Delete decisions are recorded" "registry lifecycle.delete" || missing=$((missing + 1))

  audit_path "$repo_root/docs/ai-stack.md" "Target architecture is documented" "docs/ai-stack.md" || missing=$((missing + 1))
  audit_grep 'Keep `scalvert/dotfiles` as the foundation' "$repo_root/docs/ai-stack.md" "Foundation decision is explicit" "docs/ai-stack.md decision section" || missing=$((missing + 1))
  audit_grep 'packages/ai/skills/<id>/' "$repo_root/docs/ai-stack.md" "Skill representation is documented" "docs/ai-stack.md skill representation section" || missing=$((missing + 1))
  audit_path "$ai_dir/prompts/README.md" "Prompt representation is documented" "packages/ai/prompts/README.md" || missing=$((missing + 1))
  audit_path "$ai_dir/prompts/commit-message.md" "Canonical prompt source exists" "packages/ai/prompts/commit-message.md" || missing=$((missing + 1))
  audit_path "$ai_dir/skills/plannotator/manifest.yaml" "Skill manifests exist for canonical skills" "packages/ai/skills/*/manifest.yaml" || missing=$((missing + 1))
  audit_path "$ai_dir/skills/plannotator/SKILL.md" "Repo-owned canonical skill body exists" "packages/ai/skills/plannotator/SKILL.md" || missing=$((missing + 1))
  audit_path "$ai_dir/archive/2026-06-04-managed-skill-lock-orphans/README.md" "Managed skill lock orphan decision is archived" "packages/ai/archive/2026-06-04-managed-skill-lock-orphans/README.md" || missing=$((missing + 1))
  audit_path "$ai_dir/agents/README.md" "Agent representation is documented" "packages/ai/agents/README.md" || missing=$((missing + 1))
  audit_path "$ai_dir/agents/core/manifest.yaml" "Explicit agent definitions exist" "packages/ai/agents/core/manifest.yaml" || missing=$((missing + 1))

  audit_path "$ai_dir/commands/plannotator.json" "Canonical command specs exist" "packages/ai/commands/plannotator.json" || missing=$((missing + 1))
  audit_path "$ai_dir/commands/README.md" "Command spec representation is documented" "packages/ai/commands/README.md" || missing=$((missing + 1))
  audit_path "$ai_dir/generated/commands/claude/plannotator-review.md" "Generated Claude command shims exist" "packages/ai/generated/commands/claude" || missing=$((missing + 1))
  audit_path "$ai_dir/generated/commands/codex/plannotator-review.md" "Generated Codex command shims exist" "packages/ai/generated/commands/codex" || missing=$((missing + 1))
  audit_path "$ai_dir/mcp/servers.json" "Canonical MCP catalog exists" "packages/ai/mcp/servers.json" || missing=$((missing + 1))
  audit_path "$ai_dir/mcp/README.md" "MCP catalog representation is documented" "packages/ai/mcp/README.md" || missing=$((missing + 1))
  audit_path "$ai_dir/generated/mcp/shared/servers.json" "Generated shared MCP profile exists" "packages/ai/generated/mcp/shared/servers.json" || missing=$((missing + 1))
  audit_path "$ai_dir/generated/mcp/cursor/mcp.json" "Generated Cursor MCP profile exists" "packages/ai/generated/mcp/cursor/mcp.json" || missing=$((missing + 1))
  audit_path "$ai_dir/generated/mcp/codex/config.toml" "Generated Codex MCP profile exists" "packages/ai/generated/mcp/codex/config.toml" || missing=$((missing + 1))

  audit_path "$ai_dir/feedback/README.md" "Feedback-loop policy exists" "packages/ai/feedback/README.md" || missing=$((missing + 1))
  audit_mise_task "ai:feedback" "Feedback review task exists" || missing=$((missing + 1))
  audit_mise_task "ai:usage:report" "Usage age report task exists" || missing=$((missing + 1))
  audit_mise_task "ai:prompt:plan" "Prompt improvement plan task exists" || missing=$((missing + 1))
  audit_mise_task "ai:archive:plan" "Archive/dead-skill plan task exists" || missing=$((missing + 1))

  audit_path "$repo_root/install" "One-command bootstrap script exists" "install" || missing=$((missing + 1))
  audit_grep 'curl -fsSL https://raw.githubusercontent.com/scalvert/dotfiles/main/install | bash' "$repo_root/docs/ai-stack.md" "One-command bootstrap is documented" "docs/ai-stack.md bootstrap section" || missing=$((missing + 1))
  audit_mise_task "install" "mise install orchestration task exists" || missing=$((missing + 1))
  audit_mise_task "bootstrap:preflight" "bootstrap preflight task exists" || missing=$((missing + 1))
  audit_mise_task "ai:bootstrap:verify" "bootstrap verification recorder exists" || missing=$((missing + 1))
  audit_mise_task "ai:bootstrap:verify:preflight" "bootstrap verification preflight exists" || missing=$((missing + 1))
  audit_mise_task "ai:bootstrap:verification:plan" "bootstrap verification handoff task exists" || missing=$((missing + 1))
  audit_mise_task "migration:go-task:retire-check" "go-task retirement check exists" || missing=$((missing + 1))
  audit_mise_task "migration:go-task:archive-compat" "go-task compatibility archive task exists" || missing=$((missing + 1))

  audit_mise_task "reset:dry-run" "dotfiles reset dry-run task exists" || missing=$((missing + 1))
  audit_mise_task "reset" "dotfiles reset apply task exists" || missing=$((missing + 1))
  audit_mise_task "ai:reset:dry-run" "AI reset dry-run task exists" || missing=$((missing + 1))
  audit_mise_task "ai:reset" "AI reset apply task exists" || missing=$((missing + 1))
  audit_grep '## Uninstall / Reset' "$repo_root/docs/ai-stack.md" "Uninstall/reset process is documented" "docs/ai-stack.md uninstall/reset section" || missing=$((missing + 1))
  audit_grep 'There is no one-shot destructive uninstall task by design' "$repo_root/docs/ai-stack.md" "Uninstall boundary is documented" "docs/ai-stack.md uninstall/reset section" || missing=$((missing + 1))

  echo
  if [[ -d "$repo_root/taskfiles" || -e "$repo_root/Taskfile.dist.yml" ]]; then
    audit_open "Legacy go-task compatibility files remain" "Run a real bootstrap verification, then run mise run migration:go-task:archive-compat."
    open=$((open + 1))
  fi

  local verification_record
  verification_record="$(bootstrap_verification_record || true)"
  if [[ -n "$verification_record" ]]; then
    audit_ok "Fresh-machine bootstrap verification is recorded" "${verification_record#$repo_root/}"
  else
    audit_open "Fresh-machine bootstrap verification is not recorded" "On a fresh machine, VM, or clean user, run AI_BOOTSTRAP_VERIFY_ENVIRONMENT=<matching-environment> mise run ai:bootstrap:verify:preflight, then mise run ai:bootstrap:verify."
    open=$((open + 1))
  fi

  echo
  echo "Summary: $missing missing, $open open"

  if [[ "$missing" -gt 0 ]]; then
    return 1
  fi

  if [[ "$strict" == "--strict" && "$open" -gt 0 ]]; then
    return 1
  fi
}

inventory() {
  echo "AI stack source: $ai_dir"
  echo
  echo "Prompts:"
  find "$ai_dir/prompts" -type f -name '*.md' -maxdepth 1 -print | sort
  echo
  echo "MCP servers:"
  if command -v jq >/dev/null 2>&1; then
    jq -r '.mcpServers | keys[]' "$ai_dir/mcp/servers.json"
  else
    sed -n '1,120p' "$ai_dir/mcp/servers.json"
  fi
  echo
  echo "Skill manifests:"
  find "$ai_dir/skills" -mindepth 2 -maxdepth 2 -name manifest.yaml -print | sort
  echo
  echo "Command specs:"
  find "$ai_dir/commands" -type f -name '*.json' -print | sort
  echo
  echo "Generated MCP profiles:"
  if [[ -d "$ai_dir/generated/mcp" ]]; then
    find "$ai_dir/generated/mcp" -type f -print | sort
  else
    echo "missing; run scripts/ai-stack generate-mcp"
  fi
  echo
  echo "Managed skill snapshot:"
  if [[ -f "$ai_dir/skills/managed-lock.snapshot.tsv" ]]; then
    echo "$ai_dir/skills/managed-lock.snapshot.tsv"
  else
    echo "missing; run scripts/ai-stack snapshot-skills"
  fi
}

print_dirs() {
  local label="$1"
  shift

  echo "$label:"
  for path in "$@"; do
    if [[ -d "$path" ]]; then
      find "$path" -mindepth 1 -maxdepth 1 -type d -print | sort
    else
      echo "  missing: $path"
    fi
  done
  echo
}

print_files() {
  local label="$1"
  shift

  echo "$label:"
  for path in "$@"; do
    if [[ -d "$path" ]]; then
      find "$path" -maxdepth 1 -type f -name '*.md' -print | sort
    else
      echo "  missing: $path"
    fi
  done
  echo
}

print_mcp_servers() {
  echo "MCP servers:"

  if [[ -f "$HOME/.config/mcp/servers.json" ]] && command -v jq >/dev/null 2>&1; then
    jq -r '.mcpServers | keys[] | "  shared-stdio: \(.)"' "$HOME/.config/mcp/servers.json" 2>/dev/null || true
  fi

  if [[ -f "$HOME/.cursor/mcp.json" ]] && command -v jq >/dev/null 2>&1; then
    jq -r '.mcpServers | keys[] | "  cursor: \(.)"' "$HOME/.cursor/mcp.json" 2>/dev/null || true
  fi

  if [[ -f "$HOME/workspace/scio/.mcp.json" ]] && command -v jq >/dev/null 2>&1; then
    jq -r '.mcpServers | keys[] | "  scio-project: \(.)"' "$HOME/workspace/scio/.mcp.json" 2>/dev/null || true
  fi

  if [[ -f "$HOME/.codex/config.toml" ]]; then
    sed -n 's/^\[mcp_servers\.\([^].]*\)\]$/  codex: \1/p' "$HOME/.codex/config.toml" | sort
  fi

  echo
}

live_inventory() {
  echo "Live AI stack inventory"
  echo "Home: $HOME"
  echo

  print_dirs "Skill directories" \
    "$HOME/.claude/skills" \
    "$HOME/.agents/skills" \
    "$HOME/.codex/skills" \
    "$HOME/.cursor/skills-cursor"

  print_files "Command shims" \
    "$HOME/.claude/commands" \
    "$HOME/.cursor/commands" \
    "$HOME/.config/opencode/commands" \
    "$HOME/.config/opencode/command"

  print_mcp_servers

  echo "Knowledge and memory surfaces:"
  for path in \
    "$HOME/Documents/Obsidian Vault" \
    "$HOME/.claude/CLAUDE.md" \
    "$HOME/.codex/memories_1.sqlite" \
    "$HOME/.config/atuin"; do
    if [[ -e "$path" ]]; then
      echo "  present: $path"
    else
      echo "  missing: $path"
    fi
  done
}

review() {
  local tmpdir
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-stack-review.XXXXXX")"

  (find "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills-cursor" \
    -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null |
    awk -F/ '{print $NF}' |
    sort > "$tmpdir/skill-names.txt") || true

  (find "$HOME/.claude/commands" "$HOME/.cursor/commands" "$HOME/.config/opencode/commands" "$HOME/.config/opencode/command" \
    -maxdepth 1 -type f -name '*.md' -print 2>/dev/null |
    awk -F/ '{name=$NF; sub(/\.md$/, "", name); print name}' |
    sort > "$tmpdir/command-names.txt") || true

  echo "AI stack review"
  echo

  echo "Duplicate skill names across clients:"
  uniq -d "$tmpdir/skill-names.txt" | sed 's/^/  /'
  if [[ ! -s "$tmpdir/skill-names.txt" ]] || [[ -z "$(uniq -d "$tmpdir/skill-names.txt")" ]]; then
    echo "  none found"
  fi
  echo

  echo "Duplicate command names across clients:"
  uniq -d "$tmpdir/command-names.txt" | sed 's/^/  /'
  if [[ ! -s "$tmpdir/command-names.txt" ]] || [[ -z "$(uniq -d "$tmpdir/command-names.txt")" ]]; then
    echo "  none found"
  fi
  echo

  echo "Unclassified live skill names:"
  local unclassified_count=0
  while read -r skill_name; do
    case "$skill_name" in
      .system|plannotator-*|glean-*|linear-*|gws-*|scio-go-style)
        continue
        ;;
      babysit|canvas|create-hook|create-rule|create-skill|create-subagent|loop|migrate-to-skills|sdk|shell|split-to-prs|statusline|update-cli-config|update-cursor-settings)
        continue
        ;;
      agent-council|agent-council-workspace|council-discussion)
        continue
        ;;
    esac

    echo "  $skill_name"
    unclassified_count=$((unclassified_count + 1))
  done < <(sort -u "$tmpdir/skill-names.txt")
  if [[ "$unclassified_count" -eq 0 ]]; then
    echo "  none found"
  fi
  echo

  echo "Archive/dead-skill candidates to review:"
  echo "  agent-council, agent-council-workspace, council-discussion: replace with packages/ai/agents/core if no active workflow remains"
  echo "  goose/crush/superpowers config: archive unless a current workflow is identified"
  echo "  unclassified live skills above: assign owner/status or archive"
  echo

  echo "Known consolidation recommendations:"
  echo "  consolidate: plannotator-* skills and commands into packages/ai/skills/plannotator"
  echo "  keep: glean-*, gws-*, and linear-* as managed external bundles with lock metadata"
  echo "  keep-local: Cursor built-in skills and Codex app runtime plugins"
  echo "  archive-candidate: ~/.config/goose, ~/.config/crush, ~/.config/superpowers unless active workflows are identified"
  echo "  replace: broad always-on OMC guidance with explicit task-scoped agents"
  echo

  echo "Next safe action:"
  echo "  review generated command shim diffs, then install reviewed shims and archive duplicate manual shims"

  rm -rf "$tmpdir"
}

review_report() {
  local review_date="${AI_REVIEW_DATE:-$(date +%Y-%m-%d)}"
  local report_dir="$ai_dir/reviews"
  local report="$report_dir/$review_date.md"
  local stripped_report

  mkdir -p "$report_dir"

  cat > "$report" <<EOF
# AI Stack Review - $review_date

Generated by \`scripts/ai-stack report\`.

## Decision Summary

- Keep dotfiles as the foundation.
- Keep managed external bundles for Glean, Google Workspace, and Linear.
- Consolidate Plannotator commands and skills through canonical specs and generated shims.
- Replace broad always-on orchestration with explicit task-scoped agents.
- Archive before deleting.

## Inventory

\`\`\`text
$("$0" inventory)
\`\`\`

## Live Inventory

\`\`\`text
$("$0" live-inventory)
\`\`\`

## Review Findings

\`\`\`text
$("$0" review)
\`\`\`

## Skill Drift

\`\`\`text
$("$0" skill-drift)
\`\`\`

## Command Shim Diff

\`\`\`diff
$("$0" diff-commands)
\`\`\`

## Recommended Actions

1. Apply reviewed generated Plannotator command shims when ready.
2. Archive superseded manual Plannotator shims after install is verified.
3. Remove stale \`find-skills\` and \`agent-browser\` lock-only entries locally after reviewing the archive decision.
4. Decide whether Linear skills need upstream lock hashes or whether local content hashes are sufficient.
5. Classify or archive unowned live skills reported by \`mise run ai:review\`.
EOF

  stripped_report="$(mktemp "${TMPDIR:-/tmp}/ai-stack-report.XXXXXX")"
  sed 's/[[:blank:]]*$//' "$report" > "$stripped_report"
  mv "$stripped_report" "$report"

  echo "Wrote AI stack review report: $report"
}

dir_hash() {
  local dir="$1"

  if [[ ! -d "$dir" ]]; then
    echo "-"
    return 0
  fi

  local tmpfile
  tmpfile="$(mktemp "${TMPDIR:-/tmp}/ai-stack-dir-hash.XXXXXX")"

  find "$dir" -type f ! -name '.DS_Store' -print | sort | while read -r file; do
    printf '%s  %s\n' "$(sha256_file "$file")" "${file#$dir/}" >> "$tmpfile"
  done

  sha256_file "$tmpfile"
  rm -f "$tmpfile"
}

emit_skill_snapshot() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to inspect managed skills" >&2
    exit 1
  fi

  local lockfile="$HOME/.agents/.skill-lock.json"

  if [[ ! -f "$lockfile" ]]; then
    echo "missing lockfile: $lockfile" >&2
    exit 1
  fi

  jq -r '.skills | to_entries[] | [
    .key,
    (.value.sourceType // "-"),
    (.value.source // "-"),
    (.value.skillPath // "-"),
    (if ((.value.skillFolderHash // "") == "") then "-" else .value.skillFolderHash end),
    (.value.updatedAt // "-")
  ] | @tsv' "$lockfile" |
    while IFS=$'\t' read -r id source_type source skill_path lock_hash updated_at; do
      local local_hash="-"
      if [[ -d "$HOME/.agents/skills/$id" ]]; then
        local_hash="$(dir_hash "$HOME/.agents/skills/$id")"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$source_type" "$source" "$skill_path" "$lock_hash" "$local_hash" "$updated_at"
    done
}

snapshot_skills() {
  local snapshot="$ai_dir/skills/managed-lock.snapshot.tsv"

  emit_skill_snapshot > "$snapshot"

  echo "Wrote managed skill snapshot: $snapshot"
}

sanitize_skill_snapshot_for_display() {
  awk -F '\t' '
    BEGIN { OFS = "\t" }
    {
      if ($3 ~ /^(git@|https?:\/\/)/) {
        $3 = "private-source"
      }
      print
    }
  ' "$1"
}

skill_drift() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to inspect managed skills" >&2
    exit 1
  fi

  local lockfile="$HOME/.agents/.skill-lock.json"
  local snapshot="$ai_dir/skills/managed-lock.snapshot.tsv"

  if [[ ! -f "$lockfile" ]]; then
    echo "missing lockfile: $lockfile" >&2
    exit 1
  fi

  echo "Managed skill drift"
  echo

  local tmpdir
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-stack-skill-drift.XXXXXX")"

  emit_skill_snapshot > "$tmpdir/current.tsv"
  sanitize_skill_snapshot_for_display "$tmpdir/current.tsv" > "$tmpdir/current.display.tsv"

  echo "Differences from committed snapshot:"
  if [[ ! -f "$snapshot" ]]; then
    echo "  no snapshot found at $snapshot"
    echo "  run: mise run ai:snapshot:skills"
  elif cmp -s "$snapshot" "$tmpdir/current.tsv"; then
    echo "  none"
  else
    sanitize_skill_snapshot_for_display "$snapshot" > "$tmpdir/snapshot.display.tsv"
    diff -u "$tmpdir/snapshot.display.tsv" "$tmpdir/current.display.tsv" || true
  fi
  echo

  echo "Managed skills without upstream lock hash:"
  awk -F '\t' '$5 == "" || $5 == "-" { print "  " $1 " (" $3 ")" }' "$tmpdir/current.display.tsv"
  echo

  echo "Managed skills missing local directory:"
  awk -F '\t' '$6 == "-" { print "  " $1 }' "$tmpdir/current.tsv"

  rm -rf "$tmpdir"
}

generate_commands() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to generate command shims" >&2
    exit 1
  fi

  local generated_dir="$ai_dir/generated/commands"
  mkdir -p "$generated_dir/claude" "$generated_dir/codex" "$generated_dir/cursor" "$generated_dir/opencode"

  find "$ai_dir/commands" -type f -name '*.json' -print | sort | while read -r spec; do
    local count
    count="$(jq '.commands | length' "$spec")"

    local index=0
    while [[ "$index" -lt "$count" ]]; do
      local id description title shell_command task opencode_message
      id="$(jq -r ".commands[$index].id" "$spec")"
      description="$(jq -r ".commands[$index].description" "$spec")"
      title="$(jq -r ".commands[$index].title" "$spec")"
      shell_command="$(jq -r ".commands[$index].shell" "$spec")"
      task="$(jq -r ".commands[$index].task" "$spec")"
      opencode_message="$(jq -r ".commands[$index].opencodeMessage" "$spec")"

      cat > "$generated_dir/claude/$id.md" <<EOF
---
description: $description
allowed-tools: Bash(plannotator:*)
---

## $title

!\`$shell_command\`

## Your task

$task
EOF

      cat > "$generated_dir/opencode/$id.md" <<EOF
---
description: $description
---

$opencode_message
EOF

      cat > "$generated_dir/cursor/$id.md" <<EOF
# $title

$description.

Run this command from the repository or workspace context:

\`\`\`bash
$shell_command
\`\`\`

Then respond to the feedback:

$task
EOF

      cat > "$generated_dir/codex/$id.md" <<EOF
# $title

$description.

Use this command when the user asks for this Plannotator workflow:

\`\`\`bash
$shell_command
\`\`\`

After the command returns, continue with this task:

$task
EOF

      index=$((index + 1))
    done
  done

  echo "Generated command shims in $generated_dir"
}

generate_mcp() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to generate MCP profiles" >&2
    exit 1
  fi

  local generated_dir="$ai_dir/generated/mcp"
  local shared_dir="$generated_dir/shared"
  local cursor_dir="$generated_dir/cursor"
  local codex_dir="$generated_dir/codex"

  mkdir -p "$shared_dir" "$cursor_dir" "$codex_dir"

  jq -S '.' "$ai_dir/mcp/servers.json" > "$shared_dir/servers.json"
  jq -S '.' "$ai_dir/mcp/servers.json" > "$cursor_dir/mcp.json"

  {
    echo "# Generated from packages/ai/mcp/servers.json"
    echo "# Copy reviewed sections into local Codex config as needed."
    local first_server="true"
    jq -r '.mcpServers | keys[]' "$ai_dir/mcp/servers.json" | while read -r name; do
      local command
      command="$(jq -r --arg name "$name" '.mcpServers[$name].command' "$ai_dir/mcp/servers.json")"
      if [[ "$first_server" == "true" ]]; then
        first_server="false"
      else
        echo
      fi
      echo "[mcp_servers.$name]"
      printf 'command = %s\n' "$(jq -Rn --arg value "$command" '$value')"
      printf 'args = %s\n' "$(jq -c --arg name "$name" '.mcpServers[$name].args // []' "$ai_dir/mcp/servers.json")"
    done
  } > "$codex_dir/config.toml"

  echo "Generated MCP profiles in $generated_dir"
}

diff_one_command_dir() {
  local client="$1"
  local live_dir="$2"
  local generated_dir="$ai_dir/generated/commands/$client"

  echo "$client: $live_dir"
  if [[ ! -d "$live_dir" ]]; then
    echo "  missing live directory"
    echo
    return 0
  fi

  if [[ ! -d "$generated_dir" ]]; then
    echo "  missing generated directory; run scripts/ai-stack generate-commands"
    echo
    return 0
  fi

  find "$generated_dir" -maxdepth 1 -type f -name '*.md' -print | sort | while read -r generated_file; do
    local name live_file
    name="$(basename "$generated_file")"
    live_file="$live_dir/$name"

    if [[ -f "$live_file" ]]; then
      if cmp -s "$generated_file" "$live_file"; then
        echo "  unchanged: $name"
      else
        echo "  differs: $name"
        diff -u "$live_file" "$generated_file" || true
      fi
    else
      echo "  new: $name"
    fi
  done
  echo
}

diff_commands() {
  diff_one_command_dir claude "$HOME/.claude/commands"
  diff_one_command_dir cursor "$HOME/.cursor/commands"
  diff_one_command_dir opencode "$HOME/.config/opencode/commands"
  diff_one_command_dir opencode "$HOME/.config/opencode/command"
}

diff_one_mcp_file() {
  local label="$1"
  local generated_file="$2"
  local live_file="$3"

  echo "$label: $live_file"
  if [[ ! -f "$generated_file" ]]; then
    echo "  missing generated file; run scripts/ai-stack generate-mcp"
    echo
    return 0
  fi

  if [[ ! -f "$live_file" ]]; then
    echo "  missing live file"
    echo
    return 0
  fi

  if cmp -s "$generated_file" "$live_file"; then
    echo "  unchanged"
  else
    echo "  differs"
    if command -v jq >/dev/null 2>&1; then
      echo "  generated servers:"
      jq -r '.mcpServers | keys[] | "    " + .' "$generated_file" 2>/dev/null || true
      echo "  live servers:"
      jq -r '.mcpServers | keys[] | "    " + .' "$live_file" 2>/dev/null || true
    else
      echo "  install jq to inspect server-key differences"
    fi
    echo "  raw diff suppressed because live MCP config may contain private URLs or auth"
  fi
  echo
}

diff_mcp() {
  diff_one_mcp_file shared "$ai_dir/generated/mcp/shared/servers.json" "$HOME/.config/mcp/servers.json"
  diff_one_mcp_file cursor "$ai_dir/generated/mcp/cursor/mcp.json" "$HOME/.cursor/mcp.json"
  echo "codex: $HOME/.codex/config.toml"
  echo "  generated snippet: $ai_dir/generated/mcp/codex/config.toml"
  echo "  compare manually; Codex config may contain local auth, model, and trusted-project settings"
}

command_install_targets() {
  printf '%s\t%s\n' claude "$HOME/.claude/commands"
  printf '%s\t%s\n' cursor "$HOME/.cursor/commands"
  printf '%s\t%s\n' opencode "$HOME/.config/opencode/commands"
  printf '%s\t%s\n' opencode "$HOME/.config/opencode/command"
}

is_apply() {
  [[ "${1:-}" == "--apply" ]]
}

timestamp() {
  date +%Y%m%d-%H%M%S
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    echo "unknown"
  fi
}

reverse_file() {
  if command -v tac >/dev/null 2>&1; then
    tac "$1"
  else
    tail -r "$1"
  fi
}

state_home() {
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/ai-stack"
}

mtime_epoch() {
  local path="$1"

  if stat -f '%m' "$path" >/dev/null 2>&1; then
    stat -f '%m' "$path"
  elif stat -c '%Y' "$path" >/dev/null 2>&1; then
    stat -c '%Y' "$path"
  else
    echo 0
  fi
}

age_days() {
  local path="$1"
  local now epoch

  now="$(date +%s)"
  epoch="$(mtime_epoch "$path")"
  if [[ "$epoch" == "0" ]]; then
    echo "unknown"
  else
    echo $(((now - epoch) / 86400))
  fi
}

command_manifest_path() {
  echo "$(state_home)/command-install-manifest.tsv"
}

legacy_command_manifest_path() {
  echo "$HOME/.config/ai/state/command-install-manifest.tsv"
}

install_commands() {
  local mode="dry-run"
  if is_apply "${1:-}"; then
    mode="apply"
  fi

  local state_dir
  state_dir="$(state_home)"
  local backup_root="$state_dir/backups/commands/$(timestamp)"
  local manifest
  manifest="$(command_manifest_path)"

  echo "Command shim install ($mode)"
  echo

  command_install_targets | while IFS=$'\t' read -r client target_dir; do
    local generated_dir="$ai_dir/generated/commands/$client"

    if [[ ! -d "$generated_dir" ]]; then
      echo "$client: missing generated directory; run scripts/ai-stack generate-commands"
      continue
    fi

    echo "$client -> $target_dir"
    find "$generated_dir" -maxdepth 1 -type f -name '*.md' -print | sort | while read -r source_file; do
      local name target_file backup_file source_hash
      name="$(basename "$source_file")"
      target_file="$target_dir/$name"
      backup_file="$backup_root/${client}/${name}"
      source_hash="$(sha256_file "$source_file")"

      if [[ -f "$target_file" ]] && cmp -s "$source_file" "$target_file"; then
        echo "  unchanged: $name"
        continue
      fi

      if [[ "$mode" == "dry-run" ]]; then
        if [[ -f "$target_file" ]]; then
          echo "  would update: $name"
        else
          echo "  would create: $name"
        fi
        continue
      fi

      mkdir -p "$target_dir" "$(dirname "$backup_file")" "$state_dir"
      if [[ -f "$target_file" ]]; then
        cp "$target_file" "$backup_file"
      else
        backup_file="-"
      fi

      cp "$source_file" "$target_file"
      printf '%s\t%s\t%s\t%s\t%s\n' "$client" "$target_file" "$backup_file" "$source_file" "$source_hash" >> "$manifest"
      echo "  installed: $name"
    done
    echo
  done

  if [[ "$mode" == "dry-run" ]]; then
    echo "Dry run only. Re-run with --apply to write live command files."
  else
    echo "Install manifest: $manifest"
    echo "Backups: $backup_root"
  fi
}

reset_commands() {
  local mode="dry-run"
  if is_apply "${1:-}"; then
    mode="apply"
  fi

  local manifest
  manifest="$(command_manifest_path)"
  if [[ ! -f "$manifest" && -f "$(legacy_command_manifest_path)" ]]; then
    manifest="$(legacy_command_manifest_path)"
  fi

  echo "Command shim reset ($mode)"
  echo

  if [[ ! -f "$manifest" ]]; then
    echo "No command install manifest found at $manifest"
    return 0
  fi

  reverse_file "$manifest" | while IFS=$'\t' read -r client target_file backup_file source_file source_hash; do
    if [[ -z "${target_file:-}" ]]; then
      continue
    fi

    if [[ "$mode" == "dry-run" ]]; then
      if [[ "$backup_file" == "-" ]]; then
        echo "  would remove generated file: $target_file"
      else
        echo "  would restore backup: $target_file <- $backup_file"
      fi
      continue
    fi

    if [[ "$backup_file" == "-" ]]; then
      rm -f "$target_file"
      echo "  removed: $target_file"
    elif [[ -f "$backup_file" ]]; then
      cp "$backup_file" "$target_file"
      echo "  restored: $target_file"
    else
      echo "  missing backup for $target_file: $backup_file" >&2
    fi
  done

  if [[ "$mode" == "dry-run" ]]; then
    echo
    echo "Dry run only. Re-run with --apply to restore/remove installed command files."
  else
    mv "$manifest" "$manifest.restored-$(timestamp)"
  fi
}

reset_ai_stack() {
  local mode="dry-run"
  if is_apply "${1:-}"; then
    mode="apply"
  fi

  echo "AI stack reset ($mode)"
  echo
  reset_commands "${1:-}"
  echo

  local ai_link="$HOME/.config/ai"
  if [[ -L "$ai_link" ]]; then
    local current current_physical ai_physical
    current="$(readlink "$ai_link")"
    current_physical="$(cd "$current" 2>/dev/null && pwd -P || printf '%s' "$current")"
    ai_physical="$(cd "$ai_dir" 2>/dev/null && pwd -P || printf '%s' "$ai_dir")"

    if [[ "$current_physical" != "$ai_physical" ]]; then
      echo "skip unmanaged AI config symlink: $ai_link -> $current"
      echo "local state directory: $(state_home)"
      echo "State is retained for auditability; remove it manually only after review."
      return 0
    fi

    if [[ "$mode" == "apply" ]]; then
      rm "$ai_link"
      echo "removed managed AI config link: $ai_link"
    else
      echo "would remove managed AI config link: $ai_link"
    fi
  elif [[ -e "$ai_link" ]]; then
    echo "skip unmanaged AI config path: $ai_link"
  else
    echo "missing AI config path: $ai_link"
  fi

  echo "local state directory: $(state_home)"
  echo "State is retained for auditability; remove it manually only after review."
}

feedback() {
  review
  echo
  if ! skill_drift; then
    echo
    echo "Managed skill drift could not be checked. Run snapshot-skills after installing managed skills."
  fi
  echo
  usage_signals
}

emit_usage_rows() {
  local source path name age

  for source in claude agents codex cursor; do
    case "$source" in
      claude) path="$HOME/.claude/skills" ;;
      agents) path="$HOME/.agents/skills" ;;
      codex) path="$HOME/.codex/skills" ;;
      cursor) path="$HOME/.cursor/skills-cursor" ;;
    esac

    if [[ -d "$path" ]]; then
      find "$path" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort | while read -r skill_dir; do
        name="$(basename "$skill_dir")"
        age="$(age_days "$skill_dir")"
        printf 'skill\t%s\t%s\t%s\n' "$source" "$age" "$name"
      done
    fi
  done

  for source in claude cursor opencode opencode-legacy; do
    case "$source" in
      claude) path="$HOME/.claude/commands" ;;
      cursor) path="$HOME/.cursor/commands" ;;
      opencode) path="$HOME/.config/opencode/commands" ;;
      opencode-legacy) path="$HOME/.config/opencode/command" ;;
    esac

    if [[ -d "$path" ]]; then
      find "$path" -maxdepth 1 -type f -name '*.md' -print 2>/dev/null | sort | while read -r command_file; do
        name="$(basename "$command_file" .md)"
        age="$(age_days "$command_file")"
        printf 'command\t%s\t%s\t%s\n' "$source" "$age" "$name"
      done
    fi
  done
}

usage_signals() {
  echo "Usage age signals"
  echo
  echo "These are filesystem modification-age signals, not execution telemetry. Treat old entries as review candidates, not automatic delete candidates."
  echo
  printf '%-8s %-15s %-9s %s\n' "kind" "source" "age_days" "name"
  emit_usage_rows | awk -F '\t' '{ printf "%-8s %-15s %-9s %s\n", $1, $2, $3, $4 }'
}

usage_report() {
  local state_dir report_date report_file
  state_dir="$(state_home)/usage"
  report_date="${AI_REVIEW_DATE:-$(date +%Y-%m-%d)}"
  report_file="$state_dir/$report_date.md"

  mkdir -p "$state_dir"

  {
    echo "# AI Usage Age Signals - $report_date"
    echo
    echo "Generated by \`scripts/ai-stack usage-report\`."
    echo
    echo "This local report records names and filesystem modification age only. It does not inspect file contents, chat history, auth state, or private documents."
    echo
    echo "Age is a stale-review signal, not proof that a skill or command is unused."
    echo
    echo "## Entries"
    echo
    echo "| kind | source | age_days | name |"
    echo "| --- | --- | ---: | --- |"
    emit_usage_rows | awk -F '\t' '{ printf "| %s | %s | %s | %s |\n", $1, $2, $3, $4 }'
    echo
    echo "## Review Heuristic"
    echo
    echo "- 0-30 days: probably active or recently changed."
    echo "- 31-90 days: review if duplicated or unclear."
    echo "- 91+ days: stale candidate; classify, consolidate, or archive after manual review."
  } > "$report_file"

  echo "Wrote usage report: $report_file"
}

prompt_plan() {
  local state_dir plan_date plan_file tmpdir
  state_dir="$(state_home)/prompt-plans"
  plan_date="${AI_REVIEW_DATE:-$(date +%Y-%m-%d)}"
  plan_file="$state_dir/$plan_date.md"
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-stack-prompt-plan.XXXXXX")"

  mkdir -p "$state_dir"

  (find "$HOME/.claude/commands" "$HOME/.cursor/commands" "$HOME/.config/opencode/commands" "$HOME/.config/opencode/command" \
    -maxdepth 1 -type f -name '*.md' -print 2>/dev/null |
    awk -F/ '{name=$NF; sub(/\.md$/, "", name); print name}' |
    sort > "$tmpdir/command-names.txt") || true

  (find "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills-cursor" \
    -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null |
    awk -F/ '{print $NF}' |
    sort > "$tmpdir/skill-names.txt") || true

  {
    echo "# AI Prompt Improvement Plan - $plan_date"
    echo
    echo "Generated by \`scripts/ai-stack prompt-plan\`."
    echo
    echo "This is a local recommendation artifact. It records names and proposed edits only; it does not copy prompt contents, skill contents, chat history, auth state, or private documents."
    echo
    echo "## Principles"
    echo
    echo "- Prefer narrow prompt or skill edits over broad global behavior rules."
    echo "- Promote a prompt only after repeated use or repeated correction."
    echo "- Keep project-specific guidance project-local unless it clearly generalizes."
    echo "- Review suggestions manually before editing tracked prompts."
    echo
    echo "## Prompt Candidates"
    echo
    echo "- \`packages/ai/prompts/scio-go-review.md\`: candidate source is the Cursor \`go-review\` command and/or \`scio-go-style\` skill. Keep work-specific rules out of global prompts unless reused outside Scio."
    echo "- \`packages/ai/prompts/slack-draft.md\`: candidate source is the Claude \`slack-draft\` command if it is still active and broadly reusable."
    echo "- \`packages/ai/prompts/tikir-review.md\`: stale command name detected in prior reviews; classify as archive or promote to a named prompt if still useful."
    echo
    echo "## Consolidation-Driven Suggestions"
    echo
    echo "Duplicate command names:"
    if [[ -s "$tmpdir/command-names.txt" ]] && [[ -n "$(uniq -d "$tmpdir/command-names.txt")" ]]; then
      uniq -d "$tmpdir/command-names.txt" | while read -r command_name; do
        echo "- \`$command_name\`: keep one canonical spec under \`packages/ai/commands\`; generate client shims."
      done
    else
      echo "- none found"
    fi
    echo
    echo "Duplicate skill names:"
    if [[ -s "$tmpdir/skill-names.txt" ]] && [[ -n "$(uniq -d "$tmpdir/skill-names.txt")" ]]; then
      uniq -d "$tmpdir/skill-names.txt" | while read -r skill_name; do
        echo "- \`$skill_name\`: choose a canonical skill package or managed external source; archive client copies after generated/install flow exists."
      done
    else
      echo "- none found"
    fi
    echo
    echo "## Review Checklist"
    echo
    echo "1. Identify the repeated correction or repeated use case."
    echo "2. Decide whether the fix belongs in a prompt, skill, agent manifest, MCP config, or project-local docs."
    echo "3. Patch the narrowest artifact."
    echo "4. Run \`mise run ai:validate\`."
    echo "5. Archive superseded client-specific prompts only after replacement is verified."
  } > "$plan_file"

  rm -rf "$tmpdir"
  echo "Wrote prompt improvement plan: $plan_file"
}

archive_plan() {
  local state_dir plan_date plan_file tmpdir
  state_dir="$(state_home)/archive-plans"
  plan_date="${AI_REVIEW_DATE:-$(date +%Y-%m-%d)}"
  plan_file="$state_dir/$plan_date.md"
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/ai-stack-archive-plan.XXXXXX")"

  mkdir -p "$state_dir"

  (find "$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills-cursor" \
    -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null |
    awk -F/ '{print $NF}' |
    sort > "$tmpdir/skill-names.txt") || true

  (find "$HOME/.claude/commands" "$HOME/.cursor/commands" "$HOME/.config/opencode/commands" "$HOME/.config/opencode/command" \
    -maxdepth 1 -type f -name '*.md' -print 2>/dev/null |
    awk -F/ '{name=$NF; sub(/\.md$/, "", name); print name}' |
    sort > "$tmpdir/command-names.txt") || true

  {
    echo "# AI Archive Plan - $plan_date"
    echo
    echo "Generated by \`scripts/ai-stack archive-plan\`."
    echo
    echo "This is a local planning artifact. It contains names and decisions, not copied skill contents, secrets, chat history, or auth material."
    echo
    echo "## Rules"
    echo
    echo "- Archive before deleting."
    echo "- Do not archive secrets, auth files, caches, histories, or private document contents."
    echo "- Treat this as a review queue; apply nothing automatically."
    echo
    echo "## Consolidate"
    echo
    echo "Duplicate skill names across clients:"
    if [[ -s "$tmpdir/skill-names.txt" ]] && [[ -n "$(uniq -d "$tmpdir/skill-names.txt")" ]]; then
      uniq -d "$tmpdir/skill-names.txt" | sed 's/^/- /'
    else
      echo "- none found"
    fi
    echo
    echo "Duplicate command names across clients:"
    if [[ -s "$tmpdir/command-names.txt" ]] && [[ -n "$(uniq -d "$tmpdir/command-names.txt")" ]]; then
      uniq -d "$tmpdir/command-names.txt" | sed 's/^/- /'
    else
      echo "- none found"
    fi
    echo
    echo "## Archive Candidates"
    echo
    echo "- agent-council"
    echo "- agent-council-workspace"
    echo "- council-discussion"
    echo "- goose config, if no active workflow exists"
    echo "- crush config, if no active workflow exists"
    echo "- superpowers config, if no active workflow exists"
    echo
    echo "## Classify Or Archive"
    local wrote_unclassified="false"
    while read -r skill_name; do
      case "$skill_name" in
        .system|plannotator-*|glean-*|linear-*|gws-*|scio-go-style)
          continue
          ;;
        babysit|canvas|create-hook|create-rule|create-skill|create-subagent|loop|migrate-to-skills|sdk|shell|split-to-prs|statusline|update-cli-config|update-cursor-settings)
          continue
          ;;
        agent-council|agent-council-workspace|council-discussion)
          continue
          ;;
      esac
      echo "- $skill_name"
      wrote_unclassified="true"
    done < <(sort -u "$tmpdir/skill-names.txt")
    if [[ "$wrote_unclassified" == "false" ]]; then
      echo "- none found"
    fi
    echo
    echo "## Keep"
    echo
    echo "- glean-*"
    echo "- gws-*"
    echo "- linear-*"
    echo "- Cursor built-in skills"
    echo "- Codex system/runtime skills"
    echo
    echo "## Next Actions"
    echo
    echo "1. Install reviewed generated Plannotator command shims if desired."
    echo "2. Archive superseded manual Plannotator shims only after the generated shims are verified."
    echo "3. Add or update manifests for any unclassified skills that should stay."
    echo "4. Keep this plan local unless it has been sanitized for public commit."
  } > "$plan_file"

  rm -rf "$tmpdir"
  echo "Wrote archive plan: $plan_file"
}

sync_mcp() {
  generate_mcp
  cp "$ai_dir/generated/mcp/shared/servers.json" "$repo_root/packages/mcp/servers.json"
  echo "Synced generated shared MCP profile -> packages/mcp/servers.json"
}

case "${1:-}" in
  validate)
    validate
    ;;
  doctor)
    doctor
    ;;
  completion-audit)
    completion_audit "${2:-}"
    ;;
  bootstrap-verify)
    shift
    bootstrap_verify "$@"
    ;;
  bootstrap-verify-preflight)
    shift
    bootstrap_verify_preflight "$@"
    ;;
  bootstrap-verification-plan)
    shift
    bootstrap_verification_plan "$@"
    ;;
  inventory)
    inventory
    ;;
  live-inventory)
    live_inventory
    ;;
  review)
    review
    ;;
  report)
    review_report
    ;;
  snapshot-skills)
    snapshot_skills
    ;;
  skill-drift)
    skill_drift
    ;;
  feedback)
    feedback
    ;;
  usage)
    usage_signals
    ;;
  usage-report)
    usage_report
    ;;
  prompt-plan)
    prompt_plan
    ;;
  archive-plan)
    archive_plan
    ;;
  generate-commands)
    generate_commands
    ;;
  generate-mcp)
    generate_mcp
    ;;
  diff-commands)
    diff_commands
    ;;
  diff-mcp)
    diff_mcp
    ;;
  install-commands)
    install_commands "${2:-}"
    ;;
  reset-commands)
    reset_commands "${2:-}"
    ;;
  reset)
    reset_ai_stack "${2:-}"
    ;;
  sync-mcp)
    sync_mcp
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
