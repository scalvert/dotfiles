#!/usr/bin/env bash
set -euo pipefail

# Clones the private personal wiki (scalvert/wiki) into the personal workspace.
# Lives outside scripts/ai-stack on purpose: the wiki is a knowledge repo, not
# AI client config, so it is wired like fzf/shared_binutils (clone-if-absent).

WIKI_REPO="scalvert/wiki"
WIKI_PATH="${WIKI_PATH:-$HOME/workspace/personal/wiki}"
# Personal gh identity store (see fish conf.d/30-integrations.fish). The install
# flow runs outside the PWD-based switch, so point gh at it explicitly.
export GH_CONFIG_DIR="${GH_CONFIG_DIR:-$HOME/.config/gh-scalvert}"

usage() {
  echo "usage: scripts/wiki <install>" >&2
}

install() {
  if [ -d "$WIKI_PATH/.git" ]; then
    echo "wiki: already present at $WIKI_PATH"
    return 0
  fi
  # ponytail: skip (not fail) when the personal identity isn't authed yet — on a
  # fresh machine gh-personal login happens after this; rerun the task afterward.
  if ! gh auth status >/dev/null 2>&1; then
    echo "wiki: skip — personal GitHub identity not authed (GH_CONFIG_DIR=$GH_CONFIG_DIR)" >&2
    echo "      run: gh-personal; gh auth login   then: mise run wiki:install" >&2
    return 0
  fi
  mkdir -p "$(dirname "$WIKI_PATH")"
  gh repo clone "$WIKI_REPO" "$WIKI_PATH"
  echo "wiki: cloned $WIKI_REPO -> $WIKI_PATH"
}

case "${1:-install}" in
  install) install ;;
  *) usage; exit 1 ;;
esac
