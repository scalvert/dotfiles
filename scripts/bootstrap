#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

info() { printf '[INFO] %s\n' "$1"; }
ok() { printf '[OK] %s\n' "$1"; }
warn() { printf '[WARN] %s\n' "$1"; }
err() { printf '[ERROR] %s\n' "$1" >&2; }

bootstrap_state_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
}

dotfiles_commit() {
  git -C "$repo_root" rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown'
}

platform() {
  case "$(uname -s)" in
    Darwin*) printf 'darwin' ;;
    Linux*) printf 'linux' ;;
    *) printf 'unknown' ;;
  esac
}

arch() {
  case "$(uname -m)" in
    arm64|aarch64) printf 'arm64' ;;
    x86_64|amd64) printf 'x86_64' ;;
    *) uname -m ;;
  esac
}

xcode_cli_ready() {
  xcode-select -p >/dev/null 2>&1 && xcrun --find git >/dev/null 2>&1
}

install_xcode_cli() {
  if [[ "$(platform)" != "darwin" ]]; then
    return 0
  fi

  if xcode_cli_ready; then
    ok "Xcode CLI tools already installed"
    return 0
  fi

  local timeout="${XCODE_CLI_WAIT_SECONDS:-1800}"
  local elapsed=0

  info "Requesting Xcode Command Line Tools installation..."
  xcode-select --install || warn "xcode-select --install did not start a new installer; one may already be running"
  info "Complete the macOS installer prompt. This script will wait up to ${timeout}s."

  until xcode_cli_ready; do
    if [[ "$elapsed" -ge "$timeout" ]]; then
      err "Xcode Command Line Tools are not ready after ${timeout}s"
      echo
      echo "Finish the macOS installer, then rerun the bootstrap command."
      echo "If the installer failed, try:"
      echo "  sudo xcode-select --reset"
      echo "  xcode-select --install"
      echo "  xcrun --find git"
      exit 1
    fi
    sleep 5
    elapsed=$((elapsed + 5))
  done
  ok "Xcode CLI tools installed"
}

homebrew_shellenv() {
  if [[ -x /opt/homebrew/bin/brew ]]; then
    /opt/homebrew/bin/brew shellenv
  elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    /home/linuxbrew/.linuxbrew/bin/brew shellenv
  fi
}

ensure_sudo_access_for_homebrew() {
  if [[ "$(platform)" != "darwin" ]]; then
    return 0
  fi

  if sudo -n -v >/dev/null 2>&1; then
    ok "sudo access already cached"
    return 0
  fi

  if [[ ! -r /dev/tty ]]; then
    err "Homebrew needs sudo access, but no terminal is available for a password prompt"
    echo "Run 'sudo -v' in a terminal, then rerun the bootstrap command."
    exit 1
  fi

  info "Homebrew needs administrator access. Prompting for sudo password..."
  if sudo -v </dev/tty; then
    ok "sudo access cached"
  else
    err "Could not get sudo access for Homebrew installation"
    exit 1
  fi
}

install_homebrew() {
  if command -v brew >/dev/null 2>&1; then
    ok "Homebrew already installed"
    return 0
  fi

  if [[ "$(platform)" != "darwin" && "$(platform)" != "linux" ]]; then
    err "Unsupported platform for Homebrew: $(platform)"
    exit 1
  fi

  info "Installing Homebrew..."
  ensure_sudo_access_for_homebrew
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(homebrew_shellenv)"
  ok "Homebrew installed"
}

install_mise() {
  if command -v mise >/dev/null 2>&1; then
    ok "mise already installed"
    return 0
  fi

  install_homebrew
  info "Installing mise..."
  brew install mise
  ok "mise installed"
}

clone_dotfiles() {
  if [[ -f "$repo_root/mise.toml" && -d "$repo_root/.git" ]]; then
    return 0
  fi

  local dotfiles_dir="${DOTFILES_DIR:-$HOME/workspace/personal/dotfiles}"

  if [[ -d "$dotfiles_dir/.git" ]]; then
    info "Using existing dotfiles checkout at $dotfiles_dir"
    cd "$dotfiles_dir"
    return 0
  fi

  info "Cloning dotfiles to $dotfiles_dir..."
  mkdir -p "$(dirname "$dotfiles_dir")"
  git clone --branch main https://github.com/scalvert/dotfiles.git "$dotfiles_dir"
  cd "$dotfiles_dir"
}

preflight() {
  local missing=0

  printf 'Platform: %s\n' "$(platform)"

  if [[ "$(platform)" == "darwin" ]]; then
    if xcode_cli_ready; then
      ok "Xcode CLI tools"
    else
      warn "Xcode CLI tools missing or git is not available through xcrun"
      missing=1
    fi
  fi

  for tool in brew git mise; do
    if command -v "$tool" >/dev/null 2>&1; then
      ok "$tool: $("$tool" --version 2>&1 | head -n 1)"
    else
      warn "$tool missing"
      missing=1
    fi
  done

  for dir in "$HOME/.local/bin" "$HOME/.config" "$HOME/.ssh"; do
    if [[ -d "$dir" ]]; then
      ok "$dir"
    else
      info "Creating $dir"
      mkdir -p "$dir"
    fi
  done

  return "$missing"
}

status() {
  echo "=== Platform ==="
  echo "OS: $(uname -s)"
  echo "Arch: $(uname -m)"
  echo "Host: $(hostname)"
  echo
  echo "=== Tools ==="
  for tool in brew git fish nvim mise jq; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "$tool: $("$tool" --version 2>&1 | head -n 1)"
    else
      echo "$tool: not installed"
    fi
  done
  echo
  echo "=== Shell ==="
  echo "Current: ${SHELL:-unknown}"
  echo "Fish path: $(command -v fish || true)"
  if [[ -L "$HOME/.config/fish" || -d "$HOME/.config/fish" ]]; then
    echo "Fish config: $HOME/.config/fish"
  else
    echo "Fish config: not found"
  fi
}

install() {
  install_xcode_cli
  install_homebrew
  install_mise
  clone_dotfiles

  if [[ "${MISE_NO_TRUST:-}" != "1" ]]; then
    mise trust -y "$PWD/mise.toml"
  fi

  mise run install
  mark_success
}

mark_success() {
  local state_dir marker

  state_dir="$(bootstrap_state_dir)"
  marker="$state_dir/bootstrap.env"
  mkdir -p "$state_dir"

  cat > "$marker" <<EOF
date=$(date -u +%Y-%m-%d)
platform=$(platform)
arch=$(arch)
dotfiles_commit=$(dotfiles_commit)
source=mise-install
EOF

  ok "Bootstrap success marker written"
}

case "${1:-}" in
  install)
    install
    ;;
  install-homebrew)
    install_homebrew
    ;;
  install-mise)
    install_mise
    ;;
  mark-success)
    mark_success
    ;;
  preflight)
    preflight
    ;;
  status)
    status
    ;;
  *)
    echo "usage: scripts/bootstrap <install|install-homebrew|install-mise|mark-success|preflight|status>" >&2
    exit 2
    ;;
esac
