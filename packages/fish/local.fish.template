# Local Fish Configuration - NOT TRACKED IN GIT
# Copy to ~/.config/fish/local.fish for machine-specific config.
# Secrets do NOT belong here — see below.

# Anthropic API key: NOT set here anymore. conf.d/40-ai.fish fetches it from
# 1Password at shell start (op://Private/Anthropic API Key/credential).
# Just install 1Password + `op` and sign in.

# Vertex AI for Claude Code (machine-local — keep the internal GCP project id off git)
# set -gx CLAUDE_CODE_USE_VERTEX 1
# set -gx CLOUD_ML_REGION us-east5
# set -gx ANTHROPIC_VERTEX_PROJECT_ID your-project-id

# GitHub / npm / gcloud: use on-demand auth, never store tokens here
#   gh auth login    |    npm login    |    gcloud auth login

# Machine-specific configuration
# set -gx SOME_LOCAL_PATH "/path/specific/to/this/machine"
# alias myalias 'my-local-command'
