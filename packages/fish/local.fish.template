# Local Fish Configuration - NOT TRACKED IN GIT
# Copy this file to ~/.config/fish/local.fish and add your secrets

# Claude API Key (required for Neovim AI plugins)
# set -gx AI_CLAUDE_API_KEY "sk-ant-..."

# Vertex AI (if using Google Cloud for Claude)
# set -gx CLAUDE_CODE_USE_VERTEX 1
# set -gx CLOUD_ML_REGION us-east5
# set -gx ANTHROPIC_VERTEX_PROJECT_ID your-project-id

# Other AI providers (optional)
# set -gx AI_GROK_API_KEY "..."
# set -gx AI_OPEN_AI_API_KEY "sk-..."

# GitHub: Use `gh auth token` dynamically instead of storing tokens
# Example: GITHUB_TOKEN=(gh auth token) some-command
# The release-it alias already does this

# Machine-specific configuration
# set -gx SOME_LOCAL_PATH "/path/specific/to/this/machine"

# Local aliases or overrides
# alias myalias 'my-local-command'
