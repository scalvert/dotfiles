#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Detect platform
detect_platform() {
  case "$(uname -s)" in
    Darwin*) PLATFORM="darwin" ;;
    Linux*)  PLATFORM="linux" ;;
    *)       PLATFORM="unknown" ;;
  esac
  info "Detected platform: $PLATFORM"
}

# Install Xcode Command Line Tools (macOS only)
xcode_cli_ready() {
  xcode-select -p &>/dev/null && xcrun --find git &>/dev/null
}

install_xcode_cli() {
  if [[ "$PLATFORM" != "darwin" ]]; then
    return 0
  fi

  if xcode_cli_ready; then
    success "Xcode CLI tools already installed"
  else
    local timeout="${XCODE_CLI_WAIT_SECONDS:-1800}"
    local elapsed=0

    info "Requesting Xcode Command Line Tools installation..."
    xcode-select --install || warn "xcode-select --install did not start a new installer; one may already be running"
    info "Complete the macOS installer prompt. This script will wait up to ${timeout}s."

    until xcode_cli_ready; do
      if [[ "$elapsed" -ge "$timeout" ]]; then
        error "Xcode Command Line Tools are not ready after ${timeout}s"
        echo ""
        echo "Finish the macOS installer, then rerun the bootstrap command."
        echo "If the installer failed, try:"
        echo "  sudo xcode-select --reset"
        echo "  xcode-select --install"
        echo "  xcrun --find git"
        exit 1
      fi
      sleep 5
      elapsed=$((elapsed + 5))
    done
    success "Xcode CLI tools installed"
  fi
}

# Install Homebrew
ensure_sudo_access_for_homebrew() {
  if [[ "$PLATFORM" != "darwin" ]]; then
    return 0
  fi

  if sudo -n -v &>/dev/null; then
    success "sudo access already cached"
    return 0
  fi

  if [[ ! -r /dev/tty ]]; then
    error "Homebrew needs sudo access, but no terminal is available for a password prompt"
    echo "Run 'sudo -v' in a terminal, then rerun the bootstrap command."
    exit 1
  fi

  info "Homebrew needs administrator access. Prompting for sudo password..."
  if sudo -v </dev/tty; then
    success "sudo access cached"
  else
    error "Could not get sudo access for Homebrew installation"
    exit 1
  fi
}

install_homebrew() {
  if command -v brew &>/dev/null; then
    success "Homebrew already installed"
    return 0
  fi

  if [[ "$PLATFORM" == "darwin" ]] || [[ "$PLATFORM" == "linux" ]]; then
    info "Installing Homebrew..."
    ensure_sudo_access_for_homebrew
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Add Homebrew to PATH for this session
    if [[ "$PLATFORM" == "darwin" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    else
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
    success "Homebrew installed"
  else
    error "Unsupported platform for Homebrew: $PLATFORM"
    exit 1
  fi
}

# Install mise task/runtime manager
install_mise() {
  if command -v mise &>/dev/null; then
    success "mise already installed"
    return 0
  fi

  info "Installing mise..."
  brew install mise
  success "mise installed"
}

# Clone dotfiles if running via curl | bash
clone_dotfiles() {
  # If we're already in a dotfiles directory with mise tasks, skip
  if [[ -f "mise.toml" ]]; then
    return 0
  fi

  DOTFILES_DIR="${DOTFILES_DIR:-$HOME/workspace/personal/dotfiles}"

  if [[ -d "$DOTFILES_DIR" ]]; then
    info "Dotfiles directory already exists at $DOTFILES_DIR"
    cd "$DOTFILES_DIR"
  else
    info "Cloning dotfiles to $DOTFILES_DIR..."
    mkdir -p "$(dirname "$DOTFILES_DIR")"
    git clone --branch main https://github.com/scalvert/dotfiles.git "$DOTFILES_DIR"
    cd "$DOTFILES_DIR"
    success "Dotfiles cloned"
  fi
}

# Main installation
main() {
  echo ""
  echo -e "${BLUE}========================================${NC}"
  echo -e "${BLUE}       Dotfiles Bootstrap Installer     ${NC}"
  echo -e "${BLUE}========================================${NC}"
  echo ""

  detect_platform

  # Phase 1: Preflight checks
  info "Running preflight checks..."
  install_xcode_cli
  install_homebrew

  # Phase 2: Install mise
  install_mise

  # Phase 3: Clone/navigate to dotfiles
  clone_dotfiles

  # Phase 4: Run full installation via mise
  echo ""
  info "Running dotfiles installation..."
  echo ""

  mise trust -y "$PWD/mise.toml"
  mise run install
  ./scripts/bootstrap mark-success

  echo ""
  echo -e "${GREEN}========================================${NC}"
  echo -e "${GREEN}       Installation Complete!           ${NC}"
  echo -e "${GREEN}========================================${NC}"
  echo ""
  success "Dotfiles have been installed successfully!"
  echo ""
  info "Next steps:"
  echo "  1. Restart your terminal or run: exec fish"
  echo "  2. Create ~/.config/fish/local.fish for secrets"
  echo "  3. Run 'mise tasks ls --local' to see available commands"
  echo ""
}

main "$@"
